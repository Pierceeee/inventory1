# Copy to .env (same folder) and fill in. One file serves the server and client.

# ---------------------------------------------------------------------------
# Server (Express API) - never sent to the browser
# ---------------------------------------------------------------------------

# Supabase -> your project -> Connect -> "Session pooler" connection string.
# (The direct db.<ref>.supabase.co host is IPv6-only and may not resolve.)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API. The anon / publishable key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API Keys -> the secret / service_role key.
# Server only: it lets the Register page create sign-in accounts. Optional -
# without it the server still starts, but Register answers 503 until it is
# set. Never give it a VITE_ prefix - anything VITE_ is bundled into every
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email addresses that are always admins, no matter what the
# database says. Optional - use it to set up the first admin, or to recover
# if you're ever locked out (e.g. after re-creating a user in Supabase, which
# gives them a new id and a fresh scanner profile). Server-only - never sent
# to the browser. See README "Locked out / first admin".
#
# Only trustworthy while Supabase -> Authentication -> Providers -> Email has
# "Confirm email" ON: the server checks this at startup and, if it is off,
# refuses to honour ADMIN_EMAILS at all (anyone could otherwise claim a
# listed address before it's confirmed). Public sign-ups off is recommended
# too, though not required once "Confirm email" is on.
ADMIN_EMAILS=

# Optional
# PORT=3001
# HOST=127.0.0.1                      see "Production / office network" below for other values
# DATABASE_SSL=false                  only for a local Postgres without TLS
# DATABASE_SSL_CA=C:\path\to\prod-ca-2021.crt
#                                     verify Supabase's certificate
#                                     (Project Settings -> Database -> SSL)
# OFFICE_TIME_ZONE=Asia/Manila        time zone for "Scanned At" in session exports

# ---------------------------------------------------------------------------
# Production / office network (README "Running it for the office") - only
# needed once this runs somewhere other than your own machine.
# ---------------------------------------------------------------------------

# Comma-separated list of single IPs and/or CIDR ranges (IPv4 and/or IPv6)
# allowed to reach this app at all - everyone else gets an Access Restricted
# page (or a JSON 403 on /api/*), never the app or a login form.
# GET /api/health is always reachable, for uptime checks.
#
# Cloud hosting: the office's PUBLIC IP(s) - both the primary and backup ISP,
# so a failover doesn't lock everyone out:
#   ALLOWED_IPS=203.0.113.10, 198.51.100.20
# Office server (reached only from the LAN): the LAN subnet instead:
#   ALLOWED_IPS=192.168.1.0/24
#
# Required (the server refuses to start without it) whenever HOST is set to
# anything other than a loopback address (127.0.0.1/::1/localhost, the
# default), OR whenever TRUST_PROXY (below) is set at all - see README for why.
ALLOWED_IPS=

# Only set this if a reverse proxy (Caddy/nginx/a load balancer) sits in
# front of this app - otherwise leave it unset (X-Forwarded-For is then
# ignored entirely, which is the safe default).
# PREFER "loopback" or the proxy's exact IP/CIDR - they only trust
# X-Forwarded-For from that specific address. A bare hop count trusts it from
# whoever connects directly, with NO check on who that is - only as safe as
# HOST being loopback (only a same-machine process can connect directly at
# all); the server warns at startup if it sees a hop count with a
# non-loopback HOST.
# NEVER set this to true/yes/* - the server refuses to start with that value,
# because it would let anyone fake their address and walk straight past
# ALLOWED_IPS via a forged X-Forwarded-For header.
#   TRUST_PROXY=loopback     preferred: the proxy runs on this machine
#   TRUST_PROXY=10.0.0.5     preferred: the proxy's exact IP
#   TRUST_PROXY=1            a bare hop count (see the warning above)
TRUST_PROXY=

# HOST (above, "Optional") matters here too: 127.0.0.1 (the default) only
# accepts connections from this machine. With a reverse proxy on the same
# machine - cloud hosting AND an office server with Caddy for HTTPS - leave it
# at 127.0.0.1 (or unset) and let the proxy forward to it. Don't use 0.0.0.0
# there: it would expose this app's plain-HTTP port on the network alongside
# the proxy, bypassing HTTPS (and phone cameras need HTTPS).

# ---------------------------------------------------------------------------
# Docker (README "Running it with Docker") - only for docker compose
# ---------------------------------------------------------------------------
# The name or LAN IP people open, e.g. akm.adspark.lan or 192.168.1.50. Caddy
# issues its HTTPS certificate for it. docker-compose.yml sets HOST and
# TRUST_PROXY for the containers itself; ALLOWED_IPS (above) must be the
# office LAN subnet, e.g. 192.168.1.0/24.
# AKM_HOSTNAME=akm.adspark.lan

# ---------------------------------------------------------------------------
# Client (Vite) - anything prefixed VITE_ is bundled into the browser
# ---------------------------------------------------------------------------
# Leave empty: in development Vite forwards /api to the server above.
VITE_API_BASE_URL=
