# Copy to .env (same folder) and fill in. One file serves the server and client.

# ---------------------------------------------------------------------------
# Server (Express API) - never sent to the browser
# ---------------------------------------------------------------------------

# Supabase -> your project -> Connect -> "Session pooler" connection string.
# (The direct db.<ref>.supabase.co host is IPv6-only and may not resolve.)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API. The anon / publishable key - the
# service_role key is not needed and should not be put here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Optional
# PORT=3001
# HOST=127.0.0.1
# DATABASE_SSL=false                  only for a local Postgres without TLS
# DATABASE_SSL_CA=C:\path\to\prod-ca-2021.crt
#                                     verify Supabase's certificate
#                                     (Project Settings -> Database -> SSL)

# ---------------------------------------------------------------------------
# Client (Vite) - anything prefixed VITE_ is bundled into the browser
# ---------------------------------------------------------------------------
# Leave empty: in development Vite forwards /api to the server above.
VITE_API_BASE_URL=
